; ============================================================================
;  图书馆借阅管理系统 — 配置模板
;
;  用法：复制本文件为 config.ini，填入你自己的数据库连接信息。
;        config.ini 已被 .gitignore 排除，不会进入版本控制。
;
;  ⚠️ 如果你之前把含真实密码的 config.ini 提交过，即使现在删除，
;     密码仍然留在 git 历史里。公开仓库必须改掉那个密码。
;
;  程序启动时按以下顺序查找配置文件：
;    1. 可执行文件所在目录的 config.ini；
;    2. 自可执行文件目录向上最多 4 层的 config.ini（便于在 build/ 里直接运行）。
;
;  也可以用环境变量临时覆盖，便于连接测试库而无需改动本文件：
;    LIBMS_DB_HOST / LIBMS_DB_PORT / LIBMS_DB_USER / LIBMS_DB_PASSWORD / LIBMS_DB_NAME
; ============================================================================

[Database]
HostName=127.0.0.1
Port=3306
UserName=root
Password=
DatabaseName=book_system
ConnectTimeout=5
